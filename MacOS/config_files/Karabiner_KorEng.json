{
	"title": "Apple keyboard Korean and Hanja keys",
	"rules": [
		{
			"description": "Use right command as Korean input toggle",
			"manipulators": [
				{
					"type": "basic",
					"conditions": [
						{
							"type": "frontmost_application_if",
							"bundle_identifiers": [
								"com.parallels.desktop",
								"com.parallels.vm",
								"com.parallels.desktop.console",
								"com.parallels.winapp."
							]
						}
					],
					"from": { 
						"key_code": "right_command",
						"modifiers": { "optional": [ "caps_lock" ] }
					},
					"to": [ { "key_code": "right_option" } ]
				},
				{ 
      		"type": "basic",
      		"conditions": [
      			{
      				"type": "frontmost_application_unless",
      				"bundle_identifiers": [
      					"com.parallels.desktop",
      					"com.parallels.vm",
								"com.parallels.desktop.console",
								"com.parallels.winapp."
							]
						}
					],
        	"from": { 
        		"key_code": "right_command",
        		"modifiers": { "optional": [ "caps_lock" ] }
        	},
          "to_if_alone": [
          	{
          		"key_code": "spacebar",
          		"modifiers": [
          			"left_control",
          			"left_option"
          		]
          	}
          ],
          "to": [ 
          	{ 
          		"key_code": "right_command",
          		"lazy": true
          	}
          ]
        }
			]
		},
		
		{
			"description": "Use right option as Hanja key",
      "manipulators": [
      	{
					"type": "basic",
					"conditions": [
						{
							"type": "frontmost_application_if",
							"bundle_identifiers": [
								"com.parallels.desktop",
								"com.parallels.vm",
								"com.parallels.desktop.console",
								"com.parallels.winapp."
							]
						}
					],
					"from": { "key_code": "right_option",
						"modifiers": { "optional": [ "caps_lock" ] }
					},
					"to": [ { "key_code": "right_control" } ]
				},
				{
					"type": "basic",
					"conditions": [
      			{
      				"type": "frontmost_application_unless",
      				"bundle_identifiers": [
      					"com.parallels.desktop",
      					"com.parallels.vm",
								"com.parallels.desktop.console",
								"com.parallels.winapp.",
								"com.google.Chrome"
							]
						},
						{
							"type": "input_source_if",
							"input_sources": [ { "language": "ko" } ]
						}
					],
					"from": { 
						"key_code": "right_option",
						"modifiers": { "optional": [ "caps_lock" ] }
					},
					"to": [
						{
							"key_code": "right_option",
							"lazy": true
						}
					],
					"to_if_alone": [
						{
							"key_code": "return_or_enter",
							"modifiers": [ "right_option" ]
						}
					]
				}
			]
		}
		
	]
}
