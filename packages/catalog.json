        "ubuntu": ["ca-certificates"],
        "macos": [],
        "amazon": ["ca-certificates"],
        "rhel": ["ca-certificates"]
      }
    },
    {
      "id": "base.apt-transport",
      "group": "base",
      "label": "Apt HTTPS transport",
