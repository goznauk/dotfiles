{
  "osTargets": [
    {
      "id": "ubuntu",
      "label": "Ubuntu",
      "packageManager": "apt",
      "commandTarget": "ubuntu",
      "implemented": true,
      "note": "The bootstrap installer supports Ubuntu first. Ubuntu 25.04 is past end of life; prefer 24.04 LTS or 26.04 LTS when possible."
    },
    {
      "id": "macos",
      "label": "macOS",
      "packageManager": "brew",
      "commandTarget": "macos",
      "implemented": false,
      "note": "The page generates brew commands and config previews."
    },
    {
      "id": "amazon",
      "label": "Amazon Linux 2023",
      "packageManager": "dnf",
      "commandTarget": "amazon",
      "implemented": false,
      "note": "The page generates dnf commands and config previews."
    },
    {
      "id": "rhel",
      "label": "RHEL 9/10",
      "packageManager": "dnf",
      "commandTarget": "rhel",
      "implemented": false,
      "note": "The page generates dnf commands and config previews."
    }
  ],
  "groups": [
    {
      "id": "base",
      "title": "Base system",
      "description": "Transport, certificates, archives, and everyday shell basics.",
      "defaultEnabled": true
    },
    {
      "id": "build",
      "title": "Build toolchain",
      "description": "Compilers, linkers, make, CMake, Ninja, and native headers.",
      "defaultEnabled": true
    },
    {
      "id": "shell",
      "title": "Shell and terminal",
      "description": "zsh, tmux, Vim, and terminal workflow tools.",
      "defaultEnabled": true
    },
    {
      "id": "git",
      "title": "Git and transfer",
      "description": "Git, Git LFS, SSH, rsync, curl, and wget.",
      "defaultEnabled": true
    },
    {
      "id": "python",
      "title": "Python",
      "description": "System Python, venv support, pipx, sqlite, and headers for builds.",
      "defaultEnabled": true
    },
    {
      "id": "network",
      "title": "Network inspection",
      "description": "IP, DNS, ports, tracing, and remote access inspection tools.",
      "defaultEnabled": true
    },
    {
      "id": "utilities",
      "title": "Modern CLI utilities",
      "description": "Search, JSON/YAML, process viewers, benchmarking, and formatting.",
      "defaultEnabled": true
    },
    {
      "id": "containers",
      "title": "Containers",
      "description": "Docker or Podman strategy, separated from distro package lists.",
      "defaultEnabled": true
    }
  ],
  "packages": [
    {
      "id": "base.ca-certificates",
      "group": "base",
      "label": "CA certificates",
      "defaultSelected": true,
