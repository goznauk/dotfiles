  "strategies": {
    "docker": [
      {
        "id": "official",
        "label": "Docker official repository",
        "description": "Use Docker Inc. packages and compose plugin on supported OS releases.",
        "defaults": ["ubuntu"]
      },
      {
        "id": "distro",
        "label": "Distro package",
        "description": "Use the OS package repository.",
        "defaults": ["amazon"]
      },
      {
        "id": "podman",
        "label": "Podman compatibility",
        "description": "Use Podman and Docker-compatible CLI behavior.",
        "defaults": ["rhel"]
      },
      {
        "id": "none",
        "label": "None",
        "description": "Skip container runtime installation.",
        "defaults": ["macos"]
      }
    ],
    "node": [
      {
        "id": "mise",
        "label": "mise",
        "description": "One manager for Node, Python, Rust, and other runtimes."
      },
      {
        "id": "nvm",
        "label": "nvm",
        "description": "Node-only shell manager."
      },
      {
        "id": "none",
        "label": "None",
        "description": "Skip Node setup."
      }
    ]
  }
