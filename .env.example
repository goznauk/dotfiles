# Used by the legacy macOS setup path.
# Ubuntu setup does not read this file.
OS=MACOS

# Packages installed by MacOS/setup-mac.sh.
OSX_PACKAGES="git zsh vim tmux curl wget openssl@3 tree htop tealdeer node"

# Old Git profile values.
# The current macOS setup script does not write these values.
GIT_PROFILE_EMAIL="you@example.com"
GIT_PROFILE_USERNAME="Your Name"

# Old separate Git identity sample.
# Kept only as a note for manual setup.
# GIT_PROFILE_COMPANY_NAME="company"
# GIT_PROFILE_COMPANY_REPOSITORY_DIR="$HOME/Projects/company"
# GIT_PROFILE_COMPANY_EMAIL="you@company.example"
# GIT_PROFILE_COMPANY_USERNAME="Your Name"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'
