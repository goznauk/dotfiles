# Used by the legacy macOS setup path. Ubuntu setup does not read this file.
OS=MACOS

# Packages installed by MacOS/setup-mac.sh.
OSX_PACKAGES="git zsh vim tmux curl wget openssl tree htop tldr node"

# Git profile written by the legacy setup path.
GIT_PROFILE_EMAIL="you@example.com"
GIT_PROFILE_USERNAME="Your Name"

# Enable if you use a separate Git identity for one repository directory.
# GIT_PROFILE_COMPANY_SEPERATE=true
# GIT_PROFILE_COMPANY_NAME="company"
# GIT_PROFILE_COMPANY_REPOSITORY_DIR="$HOME/Projects/company"
# GIT_PROFILE_COMPANY_EMAIL="you@company.example"
# GIT_PROFILE_COMPANY_USERNAME="Your Name"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'
